#!/bin/sh
# Daily fares run, in the same shape as the machine's skill-mirror window (start.sh): run now,
# then once every 24 hours, forever; a failed run does not end the loop. Each run is the full
# capture sweep, the week scan, then the page. All output is appended to
# /data/home/dan/fares-data/loop.log. Quiet: nothing is sent anywhere.
#
# Prepared only: nothing registers or starts this. The line start.sh would need is in PLAN.md.
# By hand, in a tmux window: bin/daily-loop
cd "$(dirname "$0")/.." || exit 1
DATA="${FARES_DATA:-/data/home/dan/fares-data}"
mkdir -p "$DATA"
while true; do
  started=$(date +%s)
  date -u '+%Y-%m-%dT%H:%M:%SZ fares daily run'
  bin/capture
  bin/capture --week-scan
  bin/page
  # Sleep the rest of 24 hours, so the run time does not drift later by each sweep's length.
  left=$((86400 - ($(date +%s) - started)))
  [ "$left" -gt 0 ] || left=60
  sleep "$left"
done >> "$DATA/loop.log" 2>&1
